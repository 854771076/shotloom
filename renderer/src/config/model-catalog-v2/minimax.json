              "label": "分辨率",
              "type": "select",
              "default": "768P",
              "options": [
                "480P",
                "768P"
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "content": "{{content}}",
            "resolution": "{{params.resolution}}",
            "duration": "{{params.duration}}",
            "ratio": "adaptive"
          },
          "contentTemplate": {
            "text": {
              "type": "text",
              "text": "{{text}}"
            },
            "image": {
              "type": "image_url",
              "image_url": {
                "url": "{{url}}"
              },
              "role": "{{role}}"
            },
            "video": {
              "type": "video_url",
              "video_url": {
                "url": "{{url}}"
              },
              "role": "{{role}}"
            },
            "audio": {
              "type": "audio_url",
              "audio_url": {
                "url": "{{url}}"
              },
              "role": "{{role}}"
            }
          },
          "taskIdPath": "task_id",
          "statusPath": "task.status",
          "errorPath": "task.error.message",
          "pollStatusMap": {
            "queued": "running",
            "running": "running",
            "succeeded": "completed",
            "failed": "failed",
            "cancelled": "cancelled"
          },
          "resultUrlPath": "task.content.url",
          "errorCodePath": "base_resp.status_code",
          "errorMessagePath": "base_resp.status_msg"
        }
      ]
    },
