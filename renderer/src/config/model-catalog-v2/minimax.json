            }
          },
          "outputConstraints": {
            "maxCount": 1,
            "formats": [
              "mp3"
            ]
          },
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "prompt": "{{prompt}}",
            "lyrics": "{{params.lyrics}}",
