    {
      "id": "minimax-speech-2.8-hd",
      "name": "MiniMax Speech 2.8 HD",
      "provider": "minimax",
      "upstreamModel": "speech-2.8-hd",
      "type": "audioGeneration",
      "sortOrder": 19,
      "enabled": true,
      "defaultMode": "text-to-speech",
      "modes": [
        {
          "id": "text-to-speech",
          "label": "文字转语音",
          "endpoint": {
            "method": "POST",
            "path": "/v1/t2a_v2",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 10000
            }
          },
          "outputConstraints": {
            "maxCount": 1,
            "formats": [
              "mp3"
            ]
          },
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "text": "{{prompt}}",
            "stream": false,
            "output_format": "url",
            "language_boost": "{{params.languageBoost}}",
            "voice_setting": {
              "voice_id": "{{params.voice}}",
              "speed": "{{params.speed}}",
              "vol": "{{params.volume}}",
              "pitch": "{{params.pitch}}"
            },
            "audio_setting": {
              "sample_rate": "{{params.sampleRate}}",
              "bitrate": "{{params.bitrate}}",
              "format": "mp3",
              "channel": 1
            }
          },
          "errorCodePath": "base_resp.status_code",
          "errorPath": "base_resp.status_msg",
          "resultUrlPath": "data.audio",
          "resultMimeType": "audio/mpeg",
          "resultFileExtension": "mp3",
          "params": [
            {
              "key": "prompt",
              "label": "朗读文本",
              "type": "text",
              "required": true
            },
            {
              "key": "voice",
              "label": "音色",
              "type": "text",
              "required": true,
              "default": "female-shaonv",
              "presentation": {
                "control": "voice",
                "group": "声音",
                "summary": true
              }
            },
            {
              "key": "speed",
              "label": "语速",
              "type": "number",
              "numeric": true,
              "default": 1,
              "presentation": {
                "control": "slider",
                "min": 0.5,
                "max": 2,
                "step": 0.05,
                "group": "声音",
                "summary": true,
                "scale": "log"
              }
            },
            {
              "key": "volume",
              "label": "音量",
              "type": "number",
              "numeric": true,
              "default": 1,
              "presentation": {
                "control": "slider",
                "min": 0.1,
                "max": 10,
                "step": 0.1,
                "group": "声音",
                "scale": "log"
              }
            },
            {
              "key": "pitch",
              "label": "音调",
              "type": "number",
              "numeric": true,
              "default": 0,
              "presentation": {
                "control": "slider",
                "min": -12,
                "max": 12,
                "step": 1,
                "group": "声音"
              }
            },
            {
              "key": "languageBoost",
              "label": "语种增强",
              "type": "select",
              "default": "auto",
              "options": [
                "Chinese",
                "Chinese,Yue",
                "English",
                "Arabic",
                "Russian",
                "Spanish",
                "French",
                "Portuguese",
                "German",
                "Turkish",
                "Dutch",
                "Ukrainian",
                "Vietnamese",
                "Indonesian",
                "Japanese",
                "Italian",
                "Korean",
                "Thai",
                "Polish",
